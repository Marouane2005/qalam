# Copy to .env before `docker compose up`.
# Change the bootstrap key before the service is reachable by anyone else.

QALAM_BOOTSTRAP_EMAIL=admin@example.com
QALAM_BOOTSTRAP_NAME=Admin
QALAM_BOOTSTRAP_API_KEY=change-me-please
QALAM_BOOTSTRAP_WORKSPACE=Library
QALAM_SEED_DEMO=1
QALAM_TASKS_EAGER=0
QALAM_LOG_LEVEL=INFO
QALAM_CORS_ORIGINS=http://localhost
QALAM_RATE_LIMIT_PER_MINUTE=60

# sentence-transformers tries the multilingual model and falls back to the
# local hash embedder when the package or the weights are not available.
QALAM_EMBEDDING_BACKEND=sentence-transformers
QALAM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# First configured provider with a key wins. mock is always last and needs no key.
QALAM_LLM_CHAIN=inception,nvidia,exaone,openrouter,mock
QALAM_LLM_TIMEOUT_S=45
QALAM_LLM_RETRIES=2
QALAM_LLM_RETRY_BACKOFF_S=0.5
QALAM_LLM_BREAKER_THRESHOLD=4
QALAM_LLM_BREAKER_COOLDOWN_S=30

INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3
INCEPTION_TIMEOUT_S=
INCEPTION_RETRIES=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_TIMEOUT_S=
NVIDIA_RETRIES=

# Friendli serves EXAONE on an OpenAI-compatible API. Point these at any
# compatible server, including one you run yourself.
EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1
EXAONE_MODEL=LGAI-EXAONE/EXAONE-4.0.1-32B
EXAONE_TIMEOUT_S=
EXAONE_RETRIES=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_S=
OPENROUTER_RETRIES=

# Local HTTP. For a public host, set a domain such as docs.example.com
# and Caddy will request a certificate.
QALAM_SITE_ADDRESS=:80
ACME_EMAIL=internal@localhost
POSTGRES_PASSWORD=qalam

# Used when the API runs on the host, outside Compose. Compose overrides these.
QALAM_DATABASE_URL=postgresql+psycopg://qalam:qalam@localhost:5432/qalam
QALAM_REDIS_URL=redis://localhost:6379/0
