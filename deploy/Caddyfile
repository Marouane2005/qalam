{
	email {$ACME_EMAIL:internal@localhost}
}

{$QALAM_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	handle /v1/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle /redoc {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
